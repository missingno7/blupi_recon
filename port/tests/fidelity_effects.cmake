# No golden: compare complete delivered call sequences with shared Build.
file(MAKE_DIRECTORY "${WORK}")
separate_arguments(args NATIVE_COMMAND "${ARGS}")
foreach(mode native reference)
    set(extra)
    if(mode STREQUAL "reference")
        set(extra --reference)
    endif()
    # Repeated runs must not inherit saves/settings from an earlier invocation.
    file(REMOVE_RECURSE "${WORK}/${mode}")
    execute_process(COMMAND "${EXE}" "${WORK}/${mode}.calls" --headless
        --data "${DATA}" --user "${WORK}/${mode}" --color 16 ${args} ${extra}
        --trace "${WORK}/${mode}.trace" RESULT_VARIABLE rc
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${WORK}/${mode}.log" "${out}${err}")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${mode}: ${rc}: ${out}${err}")
    endif()
endforeach()
foreach(ext calls trace)
    file(READ "${WORK}/native.${ext}" native)
    file(READ "${WORK}/reference.${ext}" reference)
    if(native STREQUAL "" OR NOT native STREQUAL reference)
        message(FATAL_ERROR "ordered ${ext} differ: inspect ${WORK}")
    endif()
endforeach()
if(NOT native MATCHES "[0-9]")
    message(FATAL_ERROR "empty scenario")
endif()
file(READ "${WORK}/native.calls" calls)
foreach(required begin end PlayImage volume pan play)
    if(NOT calls MATCHES "${required}")
        message(FATAL_ERROR "scenario did not exercise ${required}")
    endif()
endforeach()
if(EFFECTS AND NOT calls MATCHES "ObjectStart")
    message(FATAL_ERROR "effects fixture did not exercise ObjectStart")
endif()
if(SB2 AND NOT EFFECTS AND NOT calls MATCHES "PlayMusic")
    message(FATAL_ERROR "SB2 attract scenario did not exercise integer music selection")
endif()
message(STATUS "Reference Build and split: identical ordered effects, boundary mutations and every-frame trace")
