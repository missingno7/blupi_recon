# Posted script keys must be captured by the same overlay as live host keys.
get_filename_component(work_absolute "${WORK}" ABSOLUTE)
get_filename_component(root_absolute "${BUILDROOT}" ABSOLUTE)
string(FIND "${work_absolute}/" "${root_absolute}/" prefix)
if(NOT prefix EQUAL 0 OR NOT work_absolute MATCHES "/launcher_keys_sb(1|2_eggbert|2_blupi)$")
    message(FATAL_ERROR "Options-key fixture must be below its test build directory")
endif()
file(REMOVE_RECURSE "${work_absolute}")
file(MAKE_DIRECTORY "${WORK}")
set(probe_args)
set(navigate)
if(ENTRY_Y EQUAL 350)
    # SB1's probes do not inject CEvent phases. Navigate its title/player menus.
    set(navigate "1 click 112 430\n3 click 350 431\n")
else()
    file(WRITE "${WORK}/setup.probe" "1 phase 1534\n")
    set(probe_args --probe "${WORK}/setup.probe")
endif()
file(WRITE "${WORK}/baseline.input" "${navigate}5 click 90 ${ENTRY_Y}\n")
file(WRITE "${WORK}/keys.input" "${navigate}5 click 90 ${ENTRY_Y}\n8 key 117\n9 key 65\n")
file(WRITE "${WORK}/control.input" "${navigate}5 move 90 ${ENTRY_Y}\n8 key 117\n9 key 65\n")
foreach(mode baseline keys control)
    execute_process(COMMAND "${EXE}" --headless --frames 20 --data "${DATA}"
        --user "${WORK}/${mode}-user" ${probe_args}
        --input "${WORK}/${mode}.input" --trace "${WORK}/${mode}.trace"
        --present-repeat 2 --check-commands
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${mode} options-key check failed: ${rc}: ${out}${err}")
    endif()
    file(READ "${WORK}/${mode}.trace" ${mode})
endforeach()
if(NOT baseline MATCHES "5 1534 ")
    message(FATAL_ERROR "Fixture did not reach the settings screen")
endif()
if(NOT baseline STREQUAL keys)
    message(FATAL_ERROR "Posted keys leaked through the Display overlay")
endif()
if(baseline STREQUAL control)
    message(FATAL_ERROR "Control keys must reach the game while the overlay is closed")
endif()
