# Six constructor-entry wrappers are confined to these research executables.
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(init_tests "${CMAKE_CURRENT_LIST_DIR}")
    foreach(game sb1 sb2)
        if(game STREQUAL "sb1")
            set(context blupi_hist_context)
            set(lib blupi_game)
        else()
            set(context blupi2_hist_context)
            set(lib blupi2_game)
        endif()
        add_executable(fidelity_init_${game} "${init_tests}/fidelity_init.cpp")
        target_link_libraries(fidelity_init_${game} PRIVATE ${context} ${lib})
        target_compile_definitions(fidelity_init_${game} PRIVATE FIDELITY_SB2=$<STREQUAL:${game},sb2>)
        target_include_directories(fidelity_init_${game} PRIVATE "${PROJECT_SOURCE_DIR}/games/${game}")
        foreach(symbol _ZN6CDecorC1Ev _ZN6CEventC1Ev _ZN7CPixmapC1Ev _ZN6CSoundC1Ev _ZN6CMovieC1Ev _ZN8CNetworkC1Ev)
            target_link_options(fidelity_init_${game} PRIVATE "-Wl,--wrap=${symbol}")
        endforeach()
        if(WIN32)
            add_custom_command(TARGET fidelity_init_${game} POST_BUILD COMMAND ${CMAKE_COMMAND}
                -E copy_if_different $<TARGET_FILE:SDL3::SDL3> $<TARGET_FILE_DIR:fidelity_init_${game}>)
        endif()
    endforeach()
    foreach(edition sb1 sb1_eggbert sb2_eggbert sb2_blupi)
        set(game sb2)
        if(edition STREQUAL "sb1")
            set(game sb1)
            set(data "${BLUPI_TEST_DATA}")
        elseif(edition STREQUAL "sb1_eggbert")
            set(game sb1)
            set(data "${BLUPI_TEST_DATA_EGGBERT}")
        elseif(edition STREQUAL "sb2_eggbert")
            set(data "${BLUPI2_TEST_DATA}")
        else()
            set(data "${BLUPI2_TEST_DATA_BLUPI}")
        endif()
        if(data AND EXISTS "${PROJECT_SOURCE_DIR}/../.pyenv/python.exe")
            foreach(scenario attract tour editor save)
                add_test(NAME fidelity_init_${edition}_${scenario}
                    COMMAND "${PROJECT_SOURCE_DIR}/../.pyenv/python.exe" "${init_tests}/fidelity_init.py"
                    --exe $<TARGET_FILE:fidelity_init_${game}> --data "${data}" --game ${game}
                    --scenario ${scenario} --work "${CMAKE_CURRENT_BINARY_DIR}/fidelity_init_${edition}_${scenario}")
                set_tests_properties(fidelity_init_${edition}_${scenario} PROPERTIES TIMEOUT 1200)
            endforeach()
        endif()
    endforeach()
endif()
