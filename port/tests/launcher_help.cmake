execute_process(COMMAND "${EXE}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--help failed: ${rc}: ${out}${err}")
endif()
foreach(option --data --user --headless --frames --trace --probe --input --soundfont
        --screenshot --state-dump --display-log --display-dump --present --wide
        --interpolate --integer-scale --fullscreen --windowed --language --help --version)
    string(FIND "${out}" "${option}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing common option ${option}: ${out}")
    endif()
endforeach()
foreach(value "${NAME}" "${ENVIRONMENT}" "${NAME}.json" "${EXTRA}")
    string(FIND "${out}" "${value}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing game descriptor value ${value}: ${out}")
    endif()
endforeach()
file(STRINGS "${VERSION_FILE}" version LIMIT_COUNT 1)
execute_process(COMMAND "${EXE}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE out TIMEOUT 10)
string(STRIP "${out}" out)
if(NOT rc EQUAL 0 OR NOT out STREQUAL "${NAME} ${version}")
    message(FATAL_ERROR "--version: ${rc}: ${out}")
endif()
