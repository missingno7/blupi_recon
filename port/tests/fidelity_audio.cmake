# Offline callback includes the production audio.cpp, with no compat headers.
# Keep it in a separate TU from CSound's historical include/forced-include context.
set(audio_tests "${CMAKE_CURRENT_LIST_DIR}")
add_library(fidelity_audio_driver STATIC "${audio_tests}/fidelity_audio_driver.cpp")
target_include_directories(fidelity_audio_driver PUBLIC "${audio_tests}/../common")
target_link_libraries(fidelity_audio_driver PUBLIC SDL3::SDL3)
target_compile_features(fidelity_audio_driver PUBLIC cxx_std_17)
add_executable(fidelity_audio_mixer "${audio_tests}/fidelity_audio_mixer.cpp")
target_link_libraries(fidelity_audio_mixer PRIVATE fidelity_audio_driver)
add_test(NAME fidelity_audio_mixer COMMAND fidelity_audio_mixer)
# Every original SOUND folder: the whole asset tree in a development checkout, else the configured
# edition data roots (the Linux scripts' case-sensitive copies).
set(sound_roots)
if(EXISTS "${audio_tests}/../../assets/Speedy Blupi/SOUND")
    list(APPEND sound_roots --assets "${audio_tests}/../../assets")
else()
    foreach(root "${BLUPI_TEST_DATA}" "${BLUPI_TEST_DATA_EGGBERT}" "${BLUPI2_TEST_DATA}" "${BLUPI2_TEST_DATA_BLUPI}")
        if(root AND IS_DIRECTORY "${root}")
            list(APPEND sound_roots --assets "${root}")
        endif()
    endforeach()
endif()
if(Python3_EXECUTABLE AND sound_roots)
    add_test(NAME fidelity_audio_inventory COMMAND "${Python3_EXECUTABLE}"
        "${audio_tests}/fidelity_audio_inventory.py" ${sound_roots}
        --receipt "${CMAKE_CURRENT_BINARY_DIR}/fidelity_audio_inventory.json")
endif()
foreach(game sb1 sb2)
    if(game STREQUAL "sb1")
        set(context blupi_hist_context)
        set(library blupi_game)
    else()
        set(context blupi2_hist_context)
        set(library blupi2_game)
    endif()
    add_executable(fidelity_audio_buffers_${game} "${audio_tests}/fidelity_audio_buffers.cpp")
    target_include_directories(fidelity_audio_buffers_${game} PRIVATE "${audio_tests}/../games/${game}")
    target_compile_definitions(fidelity_audio_buffers_${game} PRIVATE FIDELITY_AUDIO_SB2=$<STREQUAL:${game},sb2>)
    target_link_libraries(fidelity_audio_buffers_${game} PRIVATE fidelity_audio_driver ${context} ${library})
endforeach()
foreach(edition sb1 sb1_eggbert sb2_eggbert sb2_blupi)
    set(game sb2)
    if(edition STREQUAL "sb1")
        set(data "${BLUPI_TEST_DATA}")
        set(game sb1)
    elseif(edition STREQUAL "sb1_eggbert")
        set(data "${BLUPI_TEST_DATA_EGGBERT}")
        set(game sb1)
    elseif(edition STREQUAL "sb2_eggbert")
        set(data "${BLUPI2_TEST_DATA}")
    else()
        set(data "${BLUPI2_TEST_DATA_BLUPI}")
    endif()
    if(data)
        add_test(NAME fidelity_audio_buffers_${edition} COMMAND fidelity_audio_buffers_${game}
            "${data}" "${CMAKE_CURRENT_BINARY_DIR}/fidelity_audio_buffers_${edition}_user")
    endif()
endforeach()
if(WIN32)
    add_custom_command(TARGET fidelity_audio_mixer POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:SDL3::SDL3>
            $<TARGET_FILE_DIR:fidelity_audio_mixer>)
    foreach(game sb1 sb2)
        add_custom_command(TARGET fidelity_audio_buffers_${game} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:SDL3::SDL3>
                $<TARGET_FILE_DIR:fidelity_audio_buffers_${game}>)
    endforeach()
endif()
