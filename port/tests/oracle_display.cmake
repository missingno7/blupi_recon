# Exercise the public flags and display coordinate, without a historical run.
# Each registered game/edition/depth gets a private, fresh work directory.
get_filename_component(work_absolute "${WORK}" ABSOLUTE)
get_filename_component(root_absolute "${BUILDROOT}" ABSOLUTE)
string(FIND "${work_absolute}/" "${root_absolute}/" prefix)
if(NOT prefix EQUAL 0 OR work_absolute STREQUAL root_absolute)
    message(FATAL_ERROR "oracle test work directory must be below ${BUILDROOT}")
endif()
file(REMOVE_RECURSE "${work_absolute}")
file(MAKE_DIRECTORY "${WORK}/reference" "${WORK}/normal")
foreach(mode reference normal)
    if(mode STREQUAL "reference")
        set(extra --reference)
    else()
        set(extra --render-repeat 3 --present-repeat 3)
    endif()
    execute_process(COMMAND "${EXE}" --headless --data "${DATA}" --user "${WORK}/${mode}/user"
        --color ${DEPTH} --frames 3 --trace "${WORK}/${mode}/trace.txt"
        --display-log "${WORK}/${mode}/display.log" --display-dump "${WORK}/${mode}:4" ${extra}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode}: ${result}\n${output}\n${error}")
    endif()
    file(STRINGS "${WORK}/${mode}/display.log" displays)
    list(LENGTH displays count)
    if(NOT count EQUAL 14)
        message(FATAL_ERROR "${mode}: expected 11 startup + 3 timer displays, got ${count}")
    endif()
    foreach(index RANGE 0 13)
        list(GET displays ${index} line)
        if(NOT line MATCHES "^${index} ${DEPTH} [0-9a-f]+$")
            message(FATAL_ERROR "bad display log line: ${line}")
        endif()
        string(LENGTH "${line}" length)
        string(LENGTH "${index} ${DEPTH} " prefix_length)
        math(EXPR expected_length "${prefix_length}+16")
        if(NOT length EQUAL expected_length)
            message(FATAL_ERROR "display hash must be 16 hex digits: ${line}")
        endif()
    endforeach()
    file(GLOB dumps "${WORK}/${mode}/frame_*.raw")
    list(LENGTH dumps count)
    if(NOT count EQUAL 4)
        message(FATAL_ERROR "expected dumps at displays 0,4,8,12; got ${count}")
    endif()
    foreach(index 000000 000004 000008 000012)
        set(path "${WORK}/${mode}/frame_${index}.raw")
        file(READ "${path}" header LIMIT 16 HEX)
        if(DEPTH EQUAL 8)
            set(expected "424c504680020000e001000008000000")
            set(bytes 308240)
        else()
            set(expected "424c504680020000e001000010000000")
            set(bytes 614416)
        endif()
        file(SIZE "${path}" size)
        if(NOT header STREQUAL expected OR NOT size EQUAL bytes)
            message(FATAL_ERROR "bad BLPF header/size: ${path} (${header}, ${size})")
        endif()
        if(mode STREQUAL "normal")
            file(SHA256 "${path}" normal_hash)
            file(SHA256 "${WORK}/reference/frame_${index}.raw" reference_hash)
            if(NOT normal_hash STREQUAL reference_hash)
                message(FATAL_ERROR "reference and normal dump differ at display ${index}")
            endif()
        endif()
    endforeach()
endforeach()
foreach(name display.log trace.txt)
    file(READ "${WORK}/reference/${name}" reference)
    file(READ "${WORK}/normal/${name}" normal)
    if(NOT reference STREQUAL normal)
        message(FATAL_ERROR "reference and normal ${name} differ")
    endif()
endforeach()
