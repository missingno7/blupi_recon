# The ordinary four-column golden gate, plus proof that the game's own
# attract system visited every shipped demo and wrapped to the first one.
set(ARGS "${ARGS} --demo-log ${WORK}/demos.txt --check-commands")
include(${CMAKE_CURRENT_LIST_DIR}/golden_check.cmake)
foreach(diagnostic bench time)
    if(NOT EXISTS "${WORK}/user/data/${diagnostic}.blp")
        message(FATAL_ERROR "SB2 ${diagnostic}.blp did not land in the user root")
    endif()
endforeach()
file(STRINGS ${WORK}/demos.txt demos)
set(expected 300)
set(count 0)
foreach(line IN LISTS demos)
    string(REGEX REPLACE "^[0-9]+ " "" world "${line}")
    if(NOT world STREQUAL "${expected}")
        message(FATAL_ERROR "demo sequence: expected ${expected}, got ${line}")
    endif()
    math(EXPR count "${count}+1")
    math(EXPR expected "${expected}+1")
    if(expected EQUAL 310)
        set(expected 300)
    endif()
endforeach()
if(count LESS 11)
    message(FATAL_ERROR "only ${count} demos started; need all 300..309 and a wrap")
endif()
message(STATUS "SB2 attract system: ${count} demos started, all 300..309 and wrap verified")
