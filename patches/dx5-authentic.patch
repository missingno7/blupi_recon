-// hack to mimic array literals in old c++
-#if __cplusplus < 199711
-#define RECT(A,B,C,D) MAKE_RECT(A,B,C,D)
-#define POINT(X,Y) MAKE_POINT(X,Y)
-
-inline RECT MAKE_RECT(int left, int top, int right, int bottom)
-{
-	RECT r = { left, top, right, bottom };
-	return r;
-};
-
-inline POINT MAKE_POINT(int x, int y)
-{
-	POINT p = { x, y };
-	return p;
-};
-#else
-#define RECT(A,B,C,D) RECT{A,B,C,D}
-#define POINT(X,Y) POINT{X,Y}
-#endif
-
-// helpers for POINT
-
-inline POINT operator+(POINT p, const POINT& a)
-{
-	return POINT(a.x + p.x, a.y + p.y);
-}
-
-inline POINT operator-(POINT p, const POINT& a)
-{
-	return POINT(p.x - a.x, p.y - a.y);
-}
-
-inline POINT operator*(POINT p, const POINT& a)
-{
-	return POINT(a.x * p.x, a.y * p.y);
-}
-
-inline POINT operator/(POINT p, const POINT& a)
-{
-	return POINT(p.x / a.x, p.y / a.y);
-}
-
-inline POINT operator*(POINT p, const int& a)
-{
-	return POINT(p.x * a, p.y * a);
-}
-
-inline POINT operator/(POINT p, const int& a)
-{
-	return POINT(p.x / a, p.y / a);
-}
-
-inline POINT& operator+=(POINT& p, const POINT& a)
-{
-	p.x += a.x;
-	p.y += a.y;
-	return p;
-}
-
-inline POINT& operator-=(POINT& p, const POINT& a)
-{
-	p.x -= a.x;
-	p.y -= a.y;
-	return p;
-}
-
-inline POINT& operator*=(POINT& p, const POINT& a)
-{
-	p.x *= a.x;
-	p.y *= a.y;
-	return p;
-}
-
-inline POINT& operator/=(POINT& p, const POINT& a)
-{
-	p.x /= a.x;
-	p.y /= a.y;
-	return p;
-}
-
-inline POINT& operator*=(POINT& p, const int& a)
-{
-	p.x *= a;
-	p.y *= a;
-	return p;
-}
-
-inline POINT& operator/=(POINT& p, const int& a)
-{
-	p.x /= a;
-	p.y /= a;
-	return p;
-}
-
-inline bool operator!=(POINT a, const POINT& b)
-{
-	return a.x != b.x || a.y != b.y;
-}
 
-inline bool operator==(POINT a, const POINT& b)
-{
-	return a.x == b.x && a.y == b.y;
